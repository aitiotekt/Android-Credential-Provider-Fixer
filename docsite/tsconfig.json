{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"strict": true,
		"target": "ES2022",
		"types": ["node"]
	},
	"include": [".vitepress/**/*.ts", ".vitepress/**/*.mts"]
}
