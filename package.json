{
	"name": "android-credential-provider-fixer",
	"version": "0.1.0-alpha.5",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.1.0",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo watch dev --filter=@aitiotekt/acp-fixer-tauri-app",
		"docs:check": "node scripts/dev-cli.mts docs check",
		"docs:sync": "node scripts/dev-cli.mts docs sync",
		"icons:check": "node scripts/dev-cli.mts icons check",
		"icons:sync": "node scripts/dev-cli.mts icons sync",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"prepare": "prek install",
		"security:check": "node scripts/dev-cli.mts security check",
		"architecture:check": "node scripts/dev-cli.mts architecture check",
		"test": "turbo run test",
		"typecheck": "tsc -b --pretty false",
		"version:check": "node scripts/dev-cli.mts version check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@types/node": "26.4.0",
		"turbo": "2.10.12",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
