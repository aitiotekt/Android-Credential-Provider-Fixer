{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"allowImportingTsExtensions": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "node"]
	},
	"include": ["src", "config", "*.ts", "tests"]
}
