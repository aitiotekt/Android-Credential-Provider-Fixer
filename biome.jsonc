{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!**/pnpm-lock.yaml", "!apps/tauri-app/src-tauri/icons"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useBlockStatements": "error",
				"useImportType": {
					"level": "error",
					"options": { "style": "inlineType" }
				}
			}
		}
	},
	"javascript": {
		"formatter": { "quoteStyle": "double" }
	},
	"css": {
		"parser": { "tailwindDirectives": true }
	},
	"overrides": [
		{
			// These Android entry points run directly, outside Turbo tasks and caching.
			"includes": [
				"scripts/android-release.mts",
				"scripts/lib/android-dev.mts"
			],
			"linter": { "rules": { "suspicious": { "noUndeclaredEnvVars": "off" } } }
		},
		{
			"includes": ["apps/tauri-app/src/styles.css"],
			"linter": {
				"rules": { "complexity": { "noImportantStyles": "off" } }
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "on" } }
	}
}
