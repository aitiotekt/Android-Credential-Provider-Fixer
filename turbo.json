{
	"$schema": "https://turborepo.dev/schema.json",
	"globalDependencies": ["pnpm-workspace.yaml", "tsconfig.base.json"],
	"globalPassThroughEnv": [
		"GITHUB_API_URL",
		"GITHUB_OUTPUT",
		"GITHUB_REPOSITORY",
		"GITHUB_TOKEN"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": []
		},
		"typecheck": {
			"outputs": ["dist-tsc/**"]
		}
	}
}
